{
  "info": {
    "_postman_id": "d73c4f64-1f7b-4f5a-bcb8-2ff73c0248bb",
    "name": "Restly API Demo",
    "description": "An executable walkthrough of Restly's local JSON document API. Run the requests in order. The suite creates a uniquely named demo collection, validates CRUD, queries, nesting, and cleanup, then compacts the store.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoCollection",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "parentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runId = Date.now().toString();",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('demoCollection', `postman-demo-${runId}`);",
          "  pm.collectionVariables.set('parentId', `parent-${runId}`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Service and Administration",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns an OK health response', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.version).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Store statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/stats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reports local store statistics', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.collectionCount).to.be.a('number');",
                  "  pm.expect(body.documentCount).to.be.a('number');",
                  "  pm.expect(body.dataPath).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Documents and Queries",
      "item": [
        {
          "name": "Insert document and auto-create collection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"active\": true,\n  \"score\": 42,\n  \"profile\": {\n    \"level\": 4\n  },\n  \"tags\": [\"math\", \"history\"]\n}"
            },
            "url": "{{baseUrl}}/data/{{demoCollection}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates a document with Restly metadata', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body._id).to.be.a('string');",
                  "  pm.expect(body._createdAt).to.be.a('string');",
                  "  pm.expect(body._updatedAt).to.be.a('string');",
                  "  pm.collectionVariables.set('userId', body._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Find many with filter, sort, and pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/data/{{demoCollection}}?where.active=true&where.profile.level.gte=3&sort=-score&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns the matching page', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an('array').with.length(1);",
                  "  pm.expect(body.total).to.eql(1);",
                  "  pm.expect(body.page.limit).to.eql(10);",
                  "  pm.expect(body.data[0]._id).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Find one",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/data/{{demoCollection}}/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns the inserted document', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().name).to.eql('Ada Lovelace');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Patch document",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 99,\n  \"profile\": {\n    \"city\": \"London\"\n  }\n}"
            },
            "url": "{{baseUrl}}/data/{{demoCollection}}/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('applies a JSON merge patch', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.score).to.eql(99);",
                  "  pm.expect(body.profile.level).to.eql(4);",
                  "  pm.expect(body.profile.city).to.eql('London');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT upsert parent document",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nested parent\"\n}"
            },
            "url": "{{baseUrl}}/data/{{demoCollection}}/{{parentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates the fixed-id parent document', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('parentId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Nested Collections",
      "item": [
        {
          "name": "Insert nested document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total\": 32,\n  \"currency\": \"GBP\"\n}"
            },
            "url": "{{baseUrl}}/data/{{demoCollection}}/{{parentId}}/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates a nested document with parent metadata', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body._parent.collection).to.eql(pm.collectionVariables.get('demoCollection'));",
                  "  pm.expect(body._parent.id).to.eql(pm.collectionVariables.get('parentId'));",
                  "  pm.collectionVariables.set('orderId', body._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Find nested documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/data/{{demoCollection}}/{{parentId}}/orders?where.total.gte=20&sort=-total"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('queries the nested collection', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an('array').with.length(1);",
                  "  pm.expect(body.data[0]._id).to.eql(pm.collectionVariables.get('orderId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Parent deletion is blocked while nested data exists",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/data/{{demoCollection}}/{{parentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns a conflict response', () => {",
                  "  pm.response.to.have.status(409);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('CONFLICT');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete nested document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/data/{{demoCollection}}/{{parentId}}/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deletes the nested document', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete parent document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/data/{{demoCollection}}/{{parentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deletes the parent after its nested data is removed', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete primary demo document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/data/{{demoCollection}}/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deletes the primary demo document', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Compact the store",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/maintenance/compact"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('compacts loaded collections', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
